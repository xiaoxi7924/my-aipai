    $.fn.lazyload = function(options) {
        //默认参数
        var settings = {
            type: 'img',
            attr: 'osrc',
            effect: "show",
            placeholder: '',
            threshold: 0,
            failurelimit: 0,
            event: "scroll",
            fun : function(){},
            container: window
        };
        //覆盖参数
        if (options) {
            $.extend(settings, options);
