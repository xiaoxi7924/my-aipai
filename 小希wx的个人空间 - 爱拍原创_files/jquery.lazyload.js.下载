            //如果符合条件，则设置默认图片
            if(settings.type == 'img' && $(self).attr("src") === '' && settings.placeholder){
                $(self).attr("src", settings.placeholder);
            }
            //对象处理
            $(self).one("appear", function() {
                if (!this.loaded) {
                    if(settings.type == 'img'){
                        $("<img />")
