    //我的个人空间:操作区
    mtOperate : function(){
        var _ts = this,
            $el = $('#mt_operate');

        //判断是否存在
        if($el.size() <= 0){
            return;
        }

        var $mto_nav = $el.find('.mto_nav'),       
            $mto_bd = $el.find('.mto_bd'),      
            $mtor_log = $el.find('.mtor_log'),
            $btnFace = $mtor_log.find('.btn_face'),
            $btnPost = $mtor_log.find('.btn_post'),
            $bd_log = $el.find('.bd_log');
            $bd_recommend = $el.find('.bd_recommend'),
            $text = $bd_log.find('textarea');

        //切换
        $mto_nav.find('li i').click(function(){
            var ref = $(this).attr('ref');
            if(typeof ref !== 'undefined'){
                $mto_nav.find('li').removeClass('cur');
                $(this).parent().addClass('cur');
                $mto_bd.find('.mto_bd_con').hide().end().find('.bd_'+ref).show();
                if(ref === 'log'){
                    $mtor_log.show();
                }else{
                    $mtor_log.hide();
                }
            }
        });

        //日志：表情
        var _fht = null,
            _fid = 'pop_face';
        $btnFace.click(function(){
            $(this).pop_dialog({
                id : 'pop_face',
                type : 'content',
                width : 232,
                height : 217,
                top : 22,
                left : -200,
                content : $('#html_pop_face').html(),
                afterShow : function(opt){
                    var $pop = $('#'+opt.id);

                    $pop.hover(function(){
                        if(fht){clearTimeout(fht);}
                    }, function(){
                        fht = setTimeout(function(){
                            $(this).pop_close(opt.id);
                        }, 100)
                    });

                    $pop.find('img').click(function(){
                        var ref = $(this).attr('ref'); 
                        clickFacemini(ref);
                    });
                    
                }
            });
        }).hover(function(){
            if(fht){clearTimeout(fht);}
        }, function(){
            fht = setTimeout(function(){
                $(this).pop_close(_fid);
            }, 100)
        });

        //日志：输入框
        $text.focus(function(){
            var v = $.trim($(this).val());

            if(v == '想说点什么……'){
                $(this).val('').removeClass('gray');
            }else if(v != ''){
                 var v_con = v.replace(/[想说点什么……]/g,"");
                 $(this).val(v_con);
                 $(this).removeClass('gray');
            }
        }).blur(function(){
            var v = $.trim($(this).val());
            if(v.length == 0){
                $(this).val('想说点什么……').addClass('gray');
            }
        });

        //日志：发表日志
        $btnPost.click(function(){
            var content = $.trim($text.val());

            if (content.length == 0 || content == '想说点什么……') {
                $(this).pop_alert({
                    msg : '请输入日志内容' 
                });
                $text.focus();
            } else {
                $text.val("");
                var $el = $('#mt_operate'),
                bid = _ts.bid,
                Url = 'http://'+Index.config.host+'/space.php?',
                metadatas = encodeURI("action=blog" + "&bid=" + bid + '&post=true' + '&comment='+ content + '&atoken=' + getActionToken());

                $.ajax({
                    type: "POST",
                    url: Url,
                    data: metadatas,
                    dataType: 'json',
                    success: function(ret) {
                        var _ts = Index;

                        //处理json字符串
                        var content = ret['content'].substring(0, 28);
                        //去除截取的半边表情
                        var left = content.lastIndexOf("[");
                        var right = content.lastIndexOf("]");

                        //如果前面有[URL]则去掉
                        if (content.substring(0, 5) == '[URL]') {
                            content = content.substring(5, 28);
                        }

                        if (left > right) {
                            ret['content'] = content.substring(0, left);
                        } else {
                            ret['content'] = content
                        }

                        if (ret['code'] == true) {

                            $(this).pop_alert({
                                msg : '日志发布成功！'
                            });

                            $el.next().remove();
                            $el.after('<ul class="list_tcon"> <li class="news nobor"><p><a target="_blank" href="http://'+Index.config.host+'/space.php?action=blog" >'+_ts.tools.comUBBCom(ret['content'])+'</a><span class="new"></span></p></li> </ul>');

                        } else {
                            $(this).pop_alert({
                                msg : '日志发布失败！'
                            });
                        }
                    }
                });
            }
            
        });

        //推荐
        var $reInput = $bd_recommend.find('input'),
            $closeRem = $bd_recommend.find('.close'),
            $btnRem = $bd_recommend.find('.re_btn span'),
            p = $reInput.val();

        $reInput.attr('p', p).focus(function(){
            var val = $.trim($(this).val());
            if(val === '拍子号' || val === '将替换原有推荐的拍子'){
                $(this).removeClass('gray').val('');
            }
        }).blur(function(){
            var val = $.trim($(this).val());
            if(val.length <= 0){
                $(this).addClass('gray').val($(this).attr('p'));
            }
        }).keyup(function() {
            var _this = $(this);
            var reg = /^[1-9][0-9]*$/;
            var value = _this.val();
            if (!reg.test(value) && value != "") {
                if (parseFloat(value)) {
                    value = parseFloat(value).toString().substring(0, 8);
                    _this.val(value);
                } else {
                    _this.val('');
                }
            } else {
                value = value.substring(0, 8);
                _this.val(value);
            };
        });

