var cursPos; // 窗口全局变量，保存目标 TextBox 的最后一次活动光标位置

function clickFacemini(myValue) {
	var txt1 = myValue;
	var txt2 = $('#mt_operate').find('.bd_log textarea').get(0);
	//debugger;
	if (typeof document.selection != "undefined") {
		if (!cursPos) TraceCursorPosition(txt2); // 获取光标位置
		txt2.value = txt2.value.slice(0, cursPos.start) + txt1 + txt2.value.slice(cursPos.end);
		var txtRange = txt2.createTextRange();
		txtRange.moveStart("character", txt2.value.length);
		txtRange.moveEnd("character", 0);
		txtRange.select();
	}
	else {
		var tclen = txt2.value.length;
		txt2.value = txt2.value.substr(0, txt2.selectionStart) + txt1 + txt2.value.substring(txt2.selectionStart, tclen);
	}
}

// 跟踪光标位置
function TraceCursorPosition(obj) {
	cursPos = $CursorPosition(obj);
}

function CheckWordsLeft(){
    var _wordLeft = $("#msgWordLeft");
    if(_wordLeft.length === 1){
        var _length = $("#msgContent").val().length;
        var _msgContent = $("#msgContent");
        var v = _msgContent.val();
        _wordLeft.hide();

        if(v != '' && v != '想说点什么……'){
             var v_con = v.replace(/[想说点什么……]/g,"");
             var _cont = $('#mt_operate').find('.bd_log').css("display");
             _msgContent.val(v_con);
             _msgContent.removeClass('gray');
             if (_cont == 'none'){
                 _wordLeft.hide();
             }else{
                 _wordLeft.show();
             }
        }
        _wordLeft.text("剩余"+(300-_length)+"字");
    }
}
function $CursorPosition(textBox) {
	var start = 0,
	end = 0;
	//如果是Firefox(1.5)的话，方法很简单
	if (typeof(textBox.selectionStart) == "number") {
		start = textBox.selectionStart;
		end = textBox.selectionEnd;
	}
	//下面是IE(6.0)的方法，麻烦得很，还要计算上'\n'
	else if (document.selection) {
		var range = document.selection.createRange();
		if (range.parentElement().id == textBox.id) {
			// create a selection of the whole textarea
			var range_all = document.body.createTextRange();
			range_all.moveToElementText(textBox);
			//两个range，一个是已经选择的text(range)，一个是整个textarea(range_all)
			//range_all.compareEndPoints()比较两个端点，如果range_all比range更往左(further to the left)，则
			//返回小于0的值，则range_all往右移一点，直到两个range的start相同。
			// calculate selection start point by moving beginning of range_all to beginning of range
			for (start = 0; range_all.compareEndPoints("StartToStart", range) < 0; start++)
			range_all.moveStart('character', 1);
			// get number of line breaks from textarea start to selection start and add them to start
			// 计算一下\n
			for (var i = 0; i <= start; i++) {
				if (textBox.value.charAt(i) == '\n') start++;
			}
			// create a selection of the whole textarea
			var range_all = document.body.createTextRange();
			range_all.moveToElementText(textBox);
			// calculate selection end point by moving beginning of range_all to end of range
			for (end = 0; range_all.compareEndPoints('StartToEnd', range) < 0; end++) {
				range_all.moveStart('character', 1);
			}
			// get number of line breaks from textarea start to selection end and add them to end
			for (var i = 0; i <= end; i++) {
				if (textBox.value.charAt(i) == '\n') end++;
			}
		}
	}
	//return [start, end]; // 包括选中区域的起始位置
	// modified to return as Object
	return {
		"start": start,
		"end": end,
		"item": [start, end]
	};
}

function getHumanTime()
{
	var niceTime = new Date(dateline(arguments[1]));
	return niceTime.timeformat5();
}

