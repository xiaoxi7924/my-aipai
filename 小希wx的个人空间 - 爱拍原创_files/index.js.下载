    config : {},
    tools : {
        //取数组
        getArrayItems : function(arr, num){
            var temp_array = new Array();
            for (var index in arr) {
                temp_array.push(arr[index]);
            }
            var return_array = new Array();
            for (var i = 0; i<num; i++) {
                if (temp_array.length>0) {
                    var arrIndex = Math.floor(Math.random()*temp_array.length);
                    return_array[i] = temp_array[arrIndex];
                    temp_array.splice(arrIndex, 1);
                } else {
                    break;
                }
            }
            return return_array;
        },
        comUBBCom : function(str, num) {
            var _pIndex = str.indexOf('[P]');
            if (_pIndex != - 1) {
                //存在[P]标签的为用户发的评论,系统发的评论,如打赏，飞飞等不用处理
                if (_pIndex != 0) {
                    //有引用的情况
                    var _thisQuote = str.substr(0, _pIndex);

                    //处理引用里面的换行数
                    var _thisReply = str.substr(_pIndex);

                    str = _thisQuote + replaceBr(_thisReply);
                }
                else {
                    str = replaceBr(str);
                }
            }

            str = str.replace(/\[br\]/g, "<br/>");
            //补回用户输入的空格
            str = str.replace(/\[nb\]/g, "&nbsp;");

            str = str.replace(/\[BR\]/g, "<br/>");
            /*系统回车*/
            str = str.replace(/\[T\]/g, "&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp"); //制表符
            var len = str.split("[QUOTE]").length - 1;
            str = str.replace(/\[QUOTE\]/g, "");

            if (len > 0) {

                for (i = 0; i < len; i++) {
                    str = "[QUOTE]" + str;
                }

                str = "[QUOTE_W]" + str + "[/QUOTE_W]";
            }

            str = str.replace(/\[QUOTE_W\](.+?)\[\/QUOTE_W\]/ig, "<div class='cmt_quo_wrap'>$1</div>");

            str = str.replace(/\[QUOTE\]/g, "<div class='cmt_quo'>");
            str = str.replace(/\[\/QUOTE\]/g, "</div>");

            str = str.replace(/\[QUOTE\](.+?)\[\/QUOTE\]/ig, "<div>$1</div>");
            str = str.replace(/\[QUOTE_1\](.+?)\[\/QUOTE_1\]/ig, "<div class='cmt_quoti'>$1</div>");
            str = str.replace(/\[QUOTE_2\](.+?)\[\/QUOTE_2\]/ig, "<div class='cmt_quocon'>$1</div>");
            str = str.replace(/\[USER\=0\](.+?)\[\/USER\]/ig, "<span>$1</span>");
            str = str.replace(/\[USER\=(.+?)\](.+?)\[\/USER\]/ig, "<span><a href=\"http://www.aipai.com/space.php?bid=$1\" target='_blank'>$2</a></span>");

            str = str.replace(/\[PID\]([\d]+?)\[\/PID\]/ig, '<div class="cmt_quoact"><a id="cmt_prc$1_' + num + '" onclick="checkloginNew(replyComment2, {\'_t\':this, \'id\':$1}); return false;" href="#">回复</a></div>');

            //str=str.replace(/\[PID\]([\d]+?)\[\/PID\]/ig,'');
            str = str.replace(/\[TIME\](.+?)\[\/TIME\]/ig, getHumanTime);
            str = str.replace(/\[P\](.+?)\[\/P\]/ig, "<P>$1</P>");
            str = str.replace(/(\[URL\])+([^\[\<\r\n]+aipai\.com[^\[\<\r\n]+)(\[\/URL\])+/ig, "<a href=\"$2\" target='_blank'>$2</a>");
            str = str.replace(/\[SYS\]/g, "");

            str = str.replace(/\[REWARD_SPAN]/ig, "<span>");
            str = str.replace(/\[\/REWARD_SPAN]/ig, "</span>");
            str = str.replace(/\[REWARD_STRONG]/ig, "<strong>");
            str = str.replace(/\[\/REWARD_STRONG]/ig, "</strong>");

            str = str.replace(/\[REWARD_DIV]/ig, "<div class='dsTg'>");
            str = str.replace(/\[\/REWARD_DIV]/ig, "</div>");
            str = str.replace(/\[REWARD_P]/ig, "<p class='blank2em'>");
            str = str.replace(/\[\/REWARD_P]/ig, "</p>");

            //ROLL,时间点评论处理
            str = str.replace(/\[r\](.+?)\[\/r\]/ig, "");
            str = str.replace(/\[rollContent\](.+?)\[\/rollContent\]/ig, "<span class='cmt_red'>$1</span>");
            str = str.replace(/\[r(.+?)\](.+?)\[\/r\]/ig, '\"$2\"');

            //str=str.replace(/\[QUOTE_W\](.+?)\[\/QUOTE_W\]/ig,"<div class='cmt_quo_wrap'><div class='cmt_quo'>$1</div></div>");
            //str=str.replace(/\[QUOTE\]/g,"<div class='cmt_quo'>");
            //str=str.replace(/\[\/QUOTE\g,"</div>");
            for (var j = 20; faceArrayCom[j] != undefined; j++) {
                while (str.indexOf(faceArrayCom[j]['key']) > - 1) {
                    str = str.replace(faceArrayCom[j]['key'], "<img src='" + faceArrayCom[j]["value"] + "' />");
                }
            }
            return str;
        }
    },
