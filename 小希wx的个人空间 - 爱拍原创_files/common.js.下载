        //绑定下拉事件
        popBind : function(opt){
            var _ts = opt.t, 
                pop = opt.pop, 
                top = opt.top || 16, 
                left = opt.left || 0, 
                ht = null, 
                st = null;	

            _ts.hover(function(){		   
                if(ht){clearTimeout(ht);}
                st = setTimeout(function(){
                    var of = _ts.offset(),
                        winw = $(window).width();
                    //1024分辨率
                    if(winw < 1010 && of.left > 920 && of.left < 950){
                        var _con = pop.css({
                            'top' : of.top + top, 
                            'left' : of.left - 45
                        }).show();
                    }else{
                        var _con = pop.css({
                            'top' : of.top + top, 
                            'left' : of.left + left
                        }).show();
                    }
                    var _div = _con.find('div'),
                        outerHeight = 0;
                    //兼容旧版jQuery处理（没有outerHeight方法）
                    try{
                        outerHeight = _div.outerHeight();
                    } catch(e){
                        outerHeight = _div.height() + parseInt(_div.css('paddingTop'), 10) + parseInt(_div.css('paddingBottom'), 10) + 2;
                    }
                    _con.find('span').height(outerHeight);
                    
                },100);
            }, function(){
                if(st){clearTimeout(st);}
                ht = setTimeout(function(){
                    pop.hide();
                },200);
            });
            pop.hover(function(){
                if(ht){clearTimeout(ht);}
            },function(){
                ht = setTimeout(function(){
                    pop.hide();
                },200);
            });
                
        },
