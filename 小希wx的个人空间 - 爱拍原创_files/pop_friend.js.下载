/*==================================
 *  加好友 
 * ================================*/
function pop_friend(o){
	if (o.bid == Cookies.get('b'))
	{
		$(o._t).pop_alert({title:'温馨提示',position:'down',top:18,left:-80,msg:"不能加自己为好友哦。"});
		return false;
	}
    var _nickname = o.name,_bid = o.bid,_avatar = o.avatar.replace(/_middle/g,'_big');

    function addFriendSuccess(ret){
        var msg = ret['msg'];
        if(ret['code'] === 28){
            needCaptcha = 1;
            //显示验证码
            getAuthimg('pop_friend');
            var _pf = $('#pop_friend');
            $(this).pop_reset('pop_friend', 340, 233);
            $('.auth_codew',_pf).show();
            $('.pop_btns .tips',_pf).html('请输入验证码').show();
            return false;
        }else if(ret['code'] === 29){
            msg = '你加好友太快了哦，请稍后再来加他好友吧：）'; 
        }else if(ret['code'] === 30){
            needCaptcha = 1;
            var _pf = $('#pop_friend');
            $(this).pop_reset('pop_friend', 340, 233);
            getAuthimg('pop_friend');
            $('.auth_codew',_pf).show();
            $('.pop_btns .tips',_pf).html('验证码不正确').show();
            return false;
        } 
        $(o._t).pop_alert({title:'系统提示',position:'down',top:18,left:-80,msg:msg});
    }
    function pop_friend_after(){
        var _pf = $('#pop_friend');
        $('.fri_avatar',_pf).attr('src',_avatar);
        $('.fri_name',_pf).html(_nickname).attr('href','https://web.archive.org/web/20131013140904/http://www.aipai.com/space.php?bid='+_bid);
        $('.pd_btn2',_pf).click(function(){
            $(this).pop_close('pop_friend');
        });
        //显示验证码
        if(needCaptcha ===1 ) {
            getAuthimg('pop_friend');
            $(this).pop_reset('pop_friend', 340, 233);
            $('.auth_codew',_pf).show();
        }
        //提交请求
        $('.pd_btn',_pf).click(function(){
			var t = $('textarea',_pf).val();
            friendUrl = baseUrl_app+"apps/friend.php";
			metadata = '{"tobid":'+_bid+',"action":"add","adword":"'+t+'"}';
			metadata = 'metadata='+metadata+'&atoken='+getActionToken();

            //判断验证码
            if(needCaptcha === 1) {
               //验证验证码
                var auth_code = $.trim($('.auth_code',_pf).val());
                if(auth_code.length !== 4){
                    $('.pop_btns .tips',_pf).html('请输入4位验证码').show();
                    return false;
                }

                //提交的参数添加验证码
                metadata = metadata+'&auth_code='+auth_code;
            }

			$.ajax({
				type: "POST",		
				url: friendUrl,
				dataType: 'jsonp',
				data: metadata,
			   error: function(msg)
			   {
					$(o._t).pop_alert({title:'出错提示',top:18,left:-80,position:'down',msg:'请检查网络或联系管理员。'});
			   },
			   success: addFriendSuccess
			});			
        });
    }

	//弹出层
    $(o._t).pop_dialog({
        width : 340,
        height : 183,
        top : 18,
        left : 0,
        content : html_pop_friend,
        id  : 'pop_friend',
        cls : 'pop_friend',
        title : '加'+_nickname+'为好友',
        afterShow : pop_friend_after
    });
    return false;
}


